{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "maimaid-backend",
	"main": ".worker/index.ts",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"upload_source_maps": true,
	"triggers": {
		"crons": ["0 4 * * *"],
	},
	"routes": [
		{
			"pattern": "api.rhythmeta.org",
			"custom_domain": true,
		},
	],
	"placement": {
		"mode": "smart",
	},
	"observability": {
		"enabled": true,
	},
	"limits": {
		"cpu_ms": 300000,
	},
	"d1_databases": [
		{
			"binding": "MAIMAID_D1",
			"database_name": "maimaid",
			"database_id": "7596cbdf-96ef-4d36-89fc-7c8c84ba11ad",
		},
	],
	"r2_buckets": [
		{
			"binding": "MAIMAID_DATA",
			"bucket_name": "maimaid-data",
		},
	],
}
