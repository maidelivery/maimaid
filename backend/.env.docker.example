NODE_ENV=development
HOST=0.0.0.0
PORT=8787
APP_PUBLIC_URL=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/maimaid
DIVING_FISH_OAUTH_CLIENT_ID=5b79b87f22855b80ee35243eeec07916
# Set this only when the Diving Fish application is registered as a confidential client.
DIVING_FISH_OAUTH_CLIENT_SECRET=

JWT_ISSUER=maimaid-backend
JWT_AUDIENCE=maimaid-clients
JWT_ACCESS_SECRET=replace-with-at-least-16-chars-access-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Generate with: pnpm -C backend exec node -e "import('@serenity-kit/opaque').then(async (m) => { await m.ready; console.log(m.server.createSetup()); })"
OPAQUE_SERVER_SETUP=replace-with-stable-opaque-server-setup

RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com

# Object storage is Cloudflare R2 (S3-compatible). Create the buckets in the R2
# dashboard first: unlike the old MinIO init container, nothing here creates them.
# Keep the avatar bucket private; avatars are read through GET /v1/profiles/:id/avatar.
# S3_REGION must stay "auto" for R2. Leave S3_PUBLIC_ENDPOINT unset: R2 signs and
# serves on the same host, and it only exists for split-host setups like MinIO.
# Leaving the credentials blank disables all object storage integration.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=maimaid-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Use a dedicated public R2 bucket for immutable static bundles, song covers, and
# LXNS preset avatars. Connect a custom domain and enable Cloudflare Image
# Transformations for AVIF delivery, then set the custom-domain origin here.
# Dashboard/in-process builds stay in PostgreSQL when either value is blank, and
# clients use GET /v1/static/bundle/:version. The Actions publisher requires both.
S3_STATIC_BUNDLE_BUCKET=maimaid-static-bundles
S3_STATIC_BUNDLE_PUBLIC_BASE_URL=https://static.example.com

CATALOG_SOURCE_URL=https://dp4p6x0xfi5o9.cloudfront.net/maimai/data.json

# Shared secret for /internal/jobs/*, used by the GitHub Actions bundle builder.
# Generate with `openssl rand -hex 32` and set the same value as the
# MAIMAID_INTERNAL_JOB_TOKEN repository secret. Leave blank to accept only admin
# access tokens there, which also means the Actions build cannot publish.
INTERNAL_JOB_TOKEN=

# pg_cron enqueues catalog syncs and bundle builds into "job_queue", but nothing
# consumed that queue, so those scheduled jobs never ran. Set to true to run a
# consumer inside the API process. Bundle builds now run in GitHub Actions, so the
# remaining queue work is cheap; static_bundle_build stays available for manual
# dispatch and is still the heavy in-process path.
JOB_DISPATCHER_ENABLED=false
JOB_DISPATCHER_INTERVAL_SECONDS=60
JOB_DISPATCHER_BATCH_SIZE=5
